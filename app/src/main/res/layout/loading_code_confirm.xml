<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Скелетон заголовка -->
        <View
            android:id="@+id/skeleton_title"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:background="#E0E0E0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="200dp"/>

        <!-- Скелетон описания -->
        <View
            android:id="@+id/skeleton_description"
            android:layout_width="300dp"
            android:layout_height="20dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/skeleton_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- Скелетон поля ввода -->
        <View
            android:id="@+id/skeleton_input"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/skeleton_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <!-- Скелетон кнопки -->
        <View
            android:id="@+id/skeleton_button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/skeleton_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

        <!-- Скелетон ссылки -->
        <View
            android:id="@+id/skeleton_resend"
            android:layout_width="200dp"
            android:layout_height="20dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/skeleton_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

        <!-- Скелетон таймера -->
        <View
            android:id="@+id/skeleton_timer"
            android:layout_width="250dp"
            android:layout_height="16dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/skeleton_resend"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>